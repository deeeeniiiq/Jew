# Jew can use a local Ollama model without a ChatGPT subscription or sign-in.
# Alternatively configure OpenAI API billing or optionally connect ChatGPT when eligible.
# ChatGPT OAuth redirect is http://127.0.0.1:8787/auth/callback.
# All overrides below are optional. API keys are separate from ChatGPT subscriptions.

# KG_DB_PATH=/absolute/path/to/knowledge_graph.sqlite3
# KG_FRONTEND_ORIGIN=http://127.0.0.1:5178
# OPENAI_API_KEY=   # Optional; prefer saving a key in Jew settings on Windows.
# VITE_JEW_GITHUB_URL=https://github.com/deeeeniiiq
